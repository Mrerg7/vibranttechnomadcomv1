---
// FAQ accordion: long-tail SEO (premium domain names, investment domains,
// escrow transfer) + visible answers for CRO. Mirrors FAQPage JSON-LD in SEO.astro.
const faqs = [
  {
    q: 'How much is vibranttechnomad.com?',
    a: 'The asking price is $27,500 USD. Transfer is handled via Escrow.com or your preferred licensed escrow service. Serious offers are reviewed confidentially — use “Make Offer” with your price and timeline.',
  },
  {
    q: 'How does the domain transfer work?',
    a: 'After payment clears escrow, the domain is pushed to your registrar account with full DNS control — typically within 1–3 business days. You receive a written transfer confirmation and checklist.',
  },
  {
    q: 'Can I make an offer below the asking price?',
    a: 'Yes. Click “Make Offer” and include your USD price, closing timeline, and preferred escrow service. All serious inquiries receive a direct, confidential response.',
  },
  {
    q: 'Is this good for SEO and brand building?',
    a: 'It is a brandable .com — short, rhythmic, and memorable. It naturally aligns with growing search demand around “techno nomad”, “digital nomad artist”, “remote creator”, and the creator economy, while working as a flagship brand across media, community, education, and commerce.',
  },
  {
    q: 'Why buy now?',
    a: 'Starlink-scale connectivity plus a maturing creator economy is the inflection point this name was made for. Clear, ownable language claimed now holds mindshare for years — premium brandable .coms in emerging lifestyle + tech verticals rarely get cheaper with cultural adoption.',
  },
  {
    q: 'Is the transaction secure?',
    a: 'Yes. Funds are held by a licensed escrow service until you confirm receipt of the domain. No funds are released to the seller before transfer is verified.',
  },
];
---

<section id="faq" class="bg-slate-900 border-y border-slate-800 py-20 reveal" aria-labelledby="faq-heading">
  <div class="max-w-3xl mx-auto px-8">
    <div class="text-center mb-12">
      <div class="inline-block px-4 py-1 rounded-3xl bg-cyan-500/10 text-cyan-400 text-xs font-bold tracking-[2px] mb-4">
        FREQUENT QUESTIONS
      </div>
      <h2 id="faq-heading" class="section-header tracking-[-2.5px]">Everything buyers ask.</h2>
      <p class="mt-4 text-lg text-slate-400">
        Short answers. Prefer email? <a href="/contact/" class="text-cyan-400 hover:text-cyan-300 underline underline-offset-4">Contact the seller directly</a>.
      </p>
    </div>
    <div class="space-y-4">
      {
        faqs.map((f) => (
          <details class="group bg-slate-950 border border-slate-800 rounded-2xl px-6 py-5 open:border-cyan-500/50 transition-colors">
            <summary class="cursor-pointer min-h-[48px] flex items-center justify-between gap-4 font-semibold text-lg text-white list-none">
              <span>{f.q}</span>
              <i class="fa-solid fa-chevron-down text-cyan-400 text-sm transition-transform group-open:rotate-180" aria-hidden="true" />
            </summary>
            <p class="mt-3 text-slate-400 leading-relaxed">{f.a}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-8 text-center text-sm text-slate-500">
      More detail: <a href="/faq/" class="text-cyan-400 hover:text-cyan-300 underline underline-offset-4">Full FAQ page</a>
      {' '}·{' '}<a href="/valuation/" class="text-cyan-400 hover:text-cyan-300 underline underline-offset-4">Valuation guide</a>
    </p>
  </div>
</section>
